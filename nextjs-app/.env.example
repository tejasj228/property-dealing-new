# Copy to .env.local. Keep actual credentials only in that ignored file.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/real-estate?retryWrites=true&w=majority
JWT_SECRET=replace-with-your-long-random-secret
ADMIN_USERNAME=replace-with-your-admin-username
ADMIN_PASSWORD=replace-with-your-admin-password
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
# Startup must not create collections or indexes in the existing live database.
MONGODB_AUTO_INDEX=false
MONGODB_AUTO_CREATE=false
FRONTEND_URL=http://localhost:3100
ADMIN_URL=https://your-admin-deployment.example
# Optional public read source for local use; leave unset on Vercel; leave blank to use the configured MongoDB.
# Use an absolute HTTP(S) API base URL, without a trailing slash.
LANDING_CONTENT_API_URL=
# Optional email notifications; leave blank if unused.
GMAIL_USER=
GMAIL_APP_PASSWORD=
